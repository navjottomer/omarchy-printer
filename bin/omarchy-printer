#!/usr/bin/python3
"""Stream printer status for the Omarchy bar as JSON lines.

Everything comes from software every Omarchy install already has: CUPS
(`ipptool`, talking to the local scheduler and, for fresh toner and paper
readings, to network printers directly), Avahi (`avahi-browse`, to find a
network printer's addresses and web page), `dbus-monitor` and `notify-send`.

Usage: omarchy-printer [--no-notify]

One JSON object is printed per change (never more than MAX_RECORD
characters). A line "refresh" on stdin forces an immediate update; the panel
sends it after cancelling a job or pausing a printer. The script exits when
stdin closes, so it never outlives the panel.

Two threads:

- The main thread asks the local scheduler for printers, jobs and the default
  printer (one `ipptool` run). CUPS announces job and printer changes over
  D-Bus to a short-lease subscription this script holds, so while nothing is
  printing it only polls every POLL_IDLE seconds as a safety net (every
  POLL_IDLE_NO_EVENTS seconds if D-Bus events are unavailable), and every
  POLL_ACTIVE seconds while a job is printing.
- A network thread does everything that can be slow: finding printers with
  Avahi, a TCP "knock" on every network printer every KNOCK_EVERY seconds
  (OFFLINE_AFTER misses in a row mean offline; CUPS itself only notices when
  it next sends a job), and asking printers directly for toner and paper
  every DEVICE_EVERY seconds, after a job finishes, and when a printer comes
  back. It never delays the main thread.
"""
from __future__ import annotations

import ctypes
import fcntl
import json
import os
import re
import select
import shutil
import signal
import socket
import subprocess
import sys
import tempfile
import threading
import time
import urllib.parse

POLL_ACTIVE = 2
POLL_IDLE = 60
POLL_IDLE_NO_EVENTS = 15
KNOCK_EVERY = 15
DEVICE_EVERY = 300
RESOLVE_EVERY = 1800
RESOLVE_RETRY = 60      # while a network printer cannot be found at all
REACH_TIMEOUT = 2       # seconds for each knock
OFFLINE_AFTER = 2       # missed knocks in a row before a printer counts as offline
IPPTOOL_TIMEOUT = 10    # enforced by subprocess; ipptool -T can hang on TLS
SUB_LEASE = 600         # D-Bus subscription lease (s); renewed at half-life
EVENT_DEBOUNCE = 0.3

# Bounds, so the shell never buffers an unbounded line.
MAX_PRINTERS = 8
MAX_MARKERS = 8
MAX_JOBS = 20
MAX_TEXT = 80
MAX_RECORD = 32768
MAX_ADDRS = 4
MAX_IPPTOOL_OUTPUT = 1 << 20   # bytes read from one ipptool run
MAX_AVAHI_OUTPUT = 256 << 10   # bytes read from one avahi-browse run

# Absolute paths, so nothing earlier in PATH can stand in for these.
IPPTOOL = "/usr/bin/ipptool"
AVAHI_BROWSE = "/usr/bin/avahi-browse"
NOTIFY_SEND = "/usr/bin/notify-send"
DBUS_MONITOR = "/usr/bin/dbus-monitor"

MARKER_LABELS = {"BK": "Black", "K": "Black", "C": "Cyan", "M": "Magenta", "Y": "Yellow"}
# printer-state-reasons worth a notification, by keyword prefix.
PROBLEMS = {
    "media-jam": "Paper jam",
    "media-empty": "Out of paper",
    "media-needed": "Load paper",
    "door-open": "A door is open",
    "cover-open": "The cover is open",
    "input-tray-missing": "Paper tray missing",
    "toner-empty": "Toner empty",
    "marker-supply-empty": "Toner empty",
    "output-area-full": "Output tray full",
}
# ipptool prints job-state as its keyword; numbers are accepted too.
JOB_STATES = {"3": "pending", "4": "held", "5": "printing", "6": "stopped",
              "7": "canceled", "8": "aborted", "9": "completed",
              "pending": "pending", "pending-held": "held", "processing": "printing",
              "processing-stopped": "stopped", "canceled": "canceled",
              "aborted": "aborted", "completed": "completed"}


def job_state(value) -> str:
    return JOB_STATES.get(str(value or "").strip(), "")


HEADER = ('GROUP operation-attributes-tag ATTR charset attributes-charset utf-8 '
          'ATTR naturalLanguage attributes-natural-language en ')
TESTS = {
    "cups": (
        '{ NAME "printers" OPERATION CUPS-Get-Printers ' + HEADER +
        'ATTR keyword requested-attributes printer-name,printer-info,printer-state,'
        'printer-state-reasons,printer-state-message,printer-is-accepting-jobs,'
        'queued-job-count,device-uri,marker-names,marker-levels,marker-low-levels,'
        'marker-colors,printer-is-temporary '
        'STATUS successful-ok STATUS client-error-not-found }\n'
        '{ NAME "jobs" OPERATION Get-Jobs ' + HEADER +
        'ATTR uri printer-uri ipp://localhost/ ATTR name requesting-user-name $user '
        'ATTR keyword which-jobs not-completed '
        'ATTR keyword requested-attributes job-id,job-name,job-state,job-printer-uri,'
        'job-originating-user-name,job-impressions-completed,time-at-creation '
        'STATUS successful-ok STATUS client-error-not-found }\n'
        '{ NAME "done" OPERATION Get-Jobs ' + HEADER +
        'ATTR uri printer-uri ipp://localhost/ ATTR name requesting-user-name $user '
        'ATTR keyword which-jobs completed ATTR integer limit 10 '
        'ATTR keyword requested-attributes job-id,job-name,job-state,job-printer-uri '
        'STATUS successful-ok STATUS client-error-not-found }\n'
        '{ NAME "default" OPERATION CUPS-Get-Default ' + HEADER +
        'ATTR keyword requested-attributes printer-name '
        'STATUS successful-ok STATUS client-error-not-found }\n'
    ),
    "device": (
        '{ NAME "device" OPERATION Get-Printer-Attributes ' + HEADER +
        'ATTR uri printer-uri $uri ATTR keyword requested-attributes marker-names,'
        'marker-levels,marker-low-levels,marker-colors,media-ready,'
        'printer-alert-description,printer-state-reasons '
        'STATUS successful-ok STATUS successful-ok-ignored-or-substituted-attributes }\n'
    ),
    "subscribe": (
        '{ NAME "subscribe" OPERATION Create-Printer-Subscriptions ' + HEADER +
        'ATTR uri printer-uri ipp://localhost/ ATTR name requesting-user-name $user '
        'GROUP subscription-attributes-tag ATTR uri notify-recipient-uri dbus:// '
        'ATTR keyword notify-events job-created,job-completed,job-state-changed,'
        'printer-state-changed,printer-added,printer-deleted,printer-modified '
        f'ATTR integer notify-lease-duration {SUB_LEASE} '
        'STATUS successful-ok }\n'
    ),
    "renew": (
        '{ NAME "renew" OPERATION Renew-Subscription ' + HEADER +
        'ATTR uri printer-uri ipp://localhost/ ATTR integer notify-subscription-id $subid '
        'ATTR name requesting-user-name $user '
        'GROUP subscription-attributes-tag '
        f'ATTR integer notify-lease-duration {SUB_LEASE} '
        'STATUS successful-ok }\n'
    ),
    "unsubscribe": (
        '{ NAME "unsubscribe" OPERATION Cancel-Subscription ' + HEADER +
        'ATTR uri printer-uri ipp://localhost/ ATTR integer notify-subscription-id $subid '
        'ATTR name requesting-user-name $user '
        'STATUS successful-ok }\n'
    ),
}

LINE_RE = re.compile(r"^\s+([a-z0-9-]+) \(([^)]+)\) = (.*)$")
REQUEST_RE = re.compile(r"^    \S.*\[(PASS|FAIL|SKIP)\]\s*$")
OPERATION_RE = re.compile(r"^    [A-Za-z-]+:\s*$")
SKIP_ATTRS = {"attributes-charset", "attributes-natural-language"}


def clip(value, n=MAX_TEXT) -> str:
    s = "".join(ch for ch in str(value) if ch.isprintable())
    return s[:n]


def run_capped(argv: list[str], timeout: float, limit: int) -> str | None:
    """Run argv and return its stdout, reading at most `limit` bytes.

    Returns None if it cannot start, runs past `timeout`, or prints more than
    `limit` bytes; the command is then killed. Printers and mDNS advertisers
    control this output, so it is never read without a bound.
    """
    try:
        proc = subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                                stderr=subprocess.DEVNULL)
    except OSError:
        return None
    buf = bytearray()
    ok = False
    deadline = time.monotonic() + timeout
    try:
        fd = proc.stdout.fileno()
        while True:
            left = deadline - time.monotonic()
            if left <= 0 or not select.select([fd], [], [], left)[0]:
                break
            chunk = os.read(fd, 65536)
            if not chunk:
                ok = True
                break
            buf += chunk
            if len(buf) > limit:
                break
    except OSError:
        pass
    finally:
        if not ok and proc.poll() is None:
            proc.kill()
        proc.stdout.close()
        try:
            proc.wait(timeout=max(0.1, deadline - time.monotonic()))
        except subprocess.TimeoutExpired:
            proc.kill()
            proc.wait()
    return buf.decode("utf-8", "replace") if ok else None


def run_ipptool(uri: str, test_file: str, variables: dict | None = None) -> list[list[dict]]:
    """Run one ipptool test file; return, per request, its attribute groups.

    `ipptool -tv` prints, per request, an "Operation-Name:" line, the
    request's own attributes, a "NAME ... [PASS]" line, then the response
    attributes as "name (type) = value" with "-- separator --" between groups
    (one group per printer or job). Only response attributes are collected.
    """
    argv = [IPPTOOL, "-tv"]
    for k, v in (variables or {}).items():
        argv += ["-d", f"{k}={v}"]
    out = run_capped(argv + [uri, test_file], IPPTOOL_TIMEOUT + 5, MAX_IPPTOOL_OUTPUT)
    if out is None:
        return []
    requests: list[list[dict]] = []
    cur: dict = {}
    collecting = False

    def close_group() -> None:
        nonlocal cur
        if cur and requests:
            requests[-1].append(cur)
        cur = {}

    for line in out.splitlines()[:20000]:
        if OPERATION_RE.match(line):
            close_group()
            collecting = False
        elif REQUEST_RE.match(line):
            close_group()
            requests.append([])
            collecting = True
        elif line.strip() == "-- separator --":
            close_group()
        elif collecting:
            m = LINE_RE.match(line)
            if m and m.group(1) not in SKIP_ATTRS:
                cur[m.group(1)] = m.group(3)[:4096]
    close_group()
    return requests


def ipptool_ok(uri: str, test_file: str, variables: dict | None = None) -> bool:
    """True if every request in the test file passed."""
    argv = [IPPTOOL, "-t"]
    for k, v in (variables or {}).items():
        argv += ["-d", f"{k}={v}"]
    try:
        return subprocess.run(argv + [uri, test_file], timeout=IPPTOOL_TIMEOUT + 5, stdin=subprocess.DEVNULL,
                              stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return False


def split_list(value: str) -> list[str]:
    return value.split(",") if value else []


def to_int(value, default=-1) -> int:
    try:
        return int(str(value).strip())
    except ValueError:
        return default


def markers_from(attrs: dict) -> list[dict]:
    names = split_list(attrs.get("marker-names", ""))
    levels = split_list(attrs.get("marker-levels", ""))
    lows = split_list(attrs.get("marker-low-levels", ""))
    colors = split_list(attrs.get("marker-colors", ""))
    out = []
    for i, name in enumerate(names[:MAX_MARKERS]):
        color = colors[i] if i < len(colors) else ""
        out.append({
            "name": clip(MARKER_LABELS.get(name, name), 24),
            "level": to_int(levels[i]) if i < len(levels) else -1,
            "low": to_int(lows[i], 10) if i < len(lows) else 10,
            "color": color if re.fullmatch(r"#[0-9A-Fa-f]{6}", color or "") else "",
        })
    return out


MEDIA_NAMES = {"iso_a4": "A4", "iso_a5": "A5", "iso_a3": "A3", "na_letter": "Letter",
               "na_legal": "Legal", "na_number-10": "Envelope #10", "iso_dl": "Envelope DL",
               "na_index-4x6": "4×6 in", "jis_b5": "B5", "iso_b5": "B5", "na_executive": "Executive"}


def media_label(value: str) -> str:
    """"iso_a4_210x297mm" -> "A4"; unknown sizes keep their dimensions."""
    v = (value or "").split(",")[0].strip()
    m = re.match(r"^([a-z]+_[a-z0-9-]+?)_(\d+(?:\.\d+)?x\d+(?:\.\d+)?(?:mm|in))$", v)
    if not m:
        return clip(v, 40)
    return MEDIA_NAMES.get(m.group(1), m.group(2))


def status_of(state: str, accepting: bool, reasons: list[str], alert: str, offline: bool = False) -> str:
    if offline or "offline" in reasons:
        return "Offline"
    if state == "stopped" or not accepting:
        return "Paused"
    if state == "processing":
        return "Printing"
    if alert.lower() == "sleep":
        return "Sleeping"
    return "Ready"


def problems_of(reasons: list[str], markers: list[dict]) -> list[str]:
    out = []
    for r in reasons:
        for key, text in PROBLEMS.items():
            if r.startswith(key) and text not in out:
                out.append(text)
    for mk in markers:
        if 0 <= mk["level"] <= mk["low"]:
            out.append(f"{mk['name']} toner low")
    return out[:6]


def reasons_from(value: str) -> list[str]:
    out = []
    for r in split_list(value):
        r = re.sub(r"-(error|warning|report)$", "", r.strip())
        if r and r != "none" and r not in out:
            out.append(clip(r, 48))
    return out[:12]


# ---------------------------------------------------------------- network

IPV4_RE = re.compile(r"^\d{1,3}(\.\d{1,3}){3}$")
IPV6_RE = re.compile(r"^[0-9A-Fa-f:]{2,39}$")
IFACE_RE = re.compile(r"^[A-Za-z0-9_.@-]{1,15}$")


def avahi_unescape(name: str) -> str:
    """avahi-browse -p escapes a service name's bytes as \\DDD (decimal)."""
    raw = re.sub(rb"\\(\d{3})", lambda m: bytes([int(m.group(1)) & 0xFF]),
                 name.encode("utf-8", "surrogateescape"))
    return raw.decode("utf-8", "replace")


def resolve_network() -> dict:
    """{service name: {"uri", "web", "addrs": [(family, addr, port, iface)]}}.

    Every announced address is kept, IPv4 first, so a printer that only has
    an IPv6 (link-local) address can still be reached.
    """
    found: dict = {}
    for service, scheme in (("_ipps._tcp", "ipps"), ("_ipp._tcp", "ipp")):
        out = run_capped([AVAHI_BROWSE, "-rpt", service], 8, MAX_AVAHI_OUTPUT)
        if out is None:
            continue
        for line in out.splitlines()[:500]:
            f = line.split(";")
            if len(f) < 10 or f[0] != "=":
                continue
            iface, name = f[1], avahi_unescape(f[3])
            host, addr, port, txt = f[6].rstrip("."), f[7], f[8], f[9]
            if not re.fullmatch(r"[A-Za-z0-9.-]{1,253}", host) or not port.isdigit():
                continue
            rp = re.search(r'"rp=([^"]*)"', txt)
            path = rp.group(1) if rp and re.fullmatch(r"[A-Za-z0-9/_.-]{0,64}", rp.group(1)) else "ipp/print"
            entry = found.get(name)
            # One entry per service name; IPPS wins over IPP.
            if entry is None or (scheme == "ipps" and entry["uri"].startswith("ipp:")):
                entry = found[name] = {"uri": f"{scheme}://{host}:{port}/{path}",
                                       "web": f"https://{host}/", "host": host, "addrs": []}
            if not entry["uri"].startswith(scheme + ":"):
                continue
            # The proto column is the network the announcement came over, not
            # the address family, so go by the address itself.
            if IPV4_RE.match(addr):
                cand = ("v4", addr, int(port), "")
            elif IPV6_RE.match(addr) and IFACE_RE.match(iface):
                cand = ("v6", addr, int(port), iface)
            else:
                continue
            if cand not in entry["addrs"] and len(entry["addrs"]) < MAX_ADDRS:
                entry["addrs"].append(cand)
    for entry in found.values():
        entry["addrs"].sort(key=lambda a: a[0] != "v4")
    scanners = resolve_scanners()
    for entry in found.values():
        if entry["host"] in scanners:
            entry["scanner"] = scanners[entry["host"]]
    return found


def txt_value(txt: str, key: str) -> str:
    m = re.search(rf'"{key}=([^"]{{0,128}})"', txt)
    return m.group(1) if m else ""


def resolve_scanners() -> dict:
    """{host: scanner} for eSCL (AirScan) scanners, matched to printers by host.

    A multifunction printer announces its scanner as _uscans._tcp (HTTPS) or
    _uscan._tcp next to its _ipps._tcp printer, under the same host name.
    """
    found: dict = {}
    for service, scheme in (("_uscans._tcp", "https"), ("_uscan._tcp", "http")):
        out = run_capped([AVAHI_BROWSE, "-rpt", service], 8, MAX_AVAHI_OUTPUT)
        if out is None:
            continue
        for line in out.splitlines()[:500]:
            f = line.split(";")
            if len(f) < 10 or f[0] != "=":
                continue
            host, addr, port, txt = f[6].rstrip("."), f[7], f[8], f[9]
            if not re.fullmatch(r"[A-Za-z0-9.-]{1,253}", host) or not port.isdigit():
                continue
            v4 = bool(IPV4_RE.match(addr))
            have = found.get(host)
            # HTTPS wins over HTTP; within one scheme, an IPv4 address wins.
            if have and not (have["https"] < (scheme == "https")
                             or (have["https"] == (scheme == "https") and v4 and not have["v4"])):
                continue
            rs = txt_value(txt, "rs") or "eSCL"
            if not re.fullmatch(r"[A-Za-z0-9_-]{1,32}", rs):
                continue
            # An IPv4 address avoids an mDNS lookup per request; otherwise the
            # .local name, which nss-mdns resolves.
            target = addr if v4 else host
            sources = [s for s in txt_value(txt, "is").split(",") if s in ("platen", "adf")]
            colors = [c for c in txt_value(txt, "cs").split(",") if c in ("color", "grayscale", "binary")]
            formats = [x for x in txt_value(txt, "pdl").split(",") if x in ("application/pdf", "image/jpeg")]
            found[host] = {
                "url": f"{scheme}://{target}:{port}/{rs}",
                "v4": v4,
                "https": scheme == "https",
                "sources": sources or ["platen"],
                "colors": colors or ["color", "grayscale"],
                "formats": formats or ["image/jpeg"],
            }
    return found


DNSSD_RE = re.compile(r"^(?:ipps?|dnssd)://([^/?]+?)\._ipps?\._tcp\.(?:local|domain)\.?/?")
PLAIN_RE = re.compile(r"^(ipps?)://(\[[0-9A-Fa-f:]+\]|[A-Za-z0-9.-]+)(?::(\d+))?(/\S*)?$")


def device_key(device_uri: str) -> str:
    """DNS-SD service name from a device URI, else ''.

    CUPS writes these as ipps://Name._ipps._tcp.local/ or, when added through
    system-config-printer and similar tools, dnssd://Name._ipps._tcp.local/.
    """
    m = DNSSD_RE.match(device_uri or "")
    return urllib.parse.unquote(m.group(1)) if m else ""


def is_network(device_uri: str) -> bool:
    return bool(device_key(device_uri) or PLAIN_RE.match(device_uri or ""))


def reach_targets(device_uri: str, network: dict) -> list:
    """Candidate socket addresses to knock on, best first."""
    key = device_key(device_uri)
    if key:
        return list((network.get(key) or {}).get("addrs", []))
    m = PLAIN_RE.match(device_uri or "")
    if m:
        return [("name", m.group(2).strip("[]"), int(m.group(3) or 631), "")]
    return []


def knock(targets: list) -> bool:
    """True if any candidate accepts a TCP connection within REACH_TIMEOUT."""
    for family, addr, port, iface in targets:
        try:
            if family == "v6":
                scope = socket.if_nametoindex(iface) if iface else 0
                with socket.socket(socket.AF_INET6, socket.SOCK_STREAM) as s:
                    s.settimeout(REACH_TIMEOUT)
                    s.connect((addr, port, 0, scope))
            else:
                with socket.create_connection((addr, port), timeout=REACH_TIMEOUT):
                    pass
            return True
        except OSError:
            continue
    return False


def scanner_of(device_uri: str, network: dict) -> dict | None:
    """What the panel needs to offer scanning, if this printer has a scanner."""
    sc = (network.get(device_key(device_uri)) or {}).get("scanner")
    if not sc:
        return None
    return {"url": sc["url"], "sources": sc["sources"], "colors": sc["colors"], "formats": sc["formats"]}


def direct_uri(device_uri: str, network: dict) -> tuple[str, str]:
    """(uri to query the printer itself, its web page) or ('', '')."""
    key = device_key(device_uri)
    if key:
        entry = network.get(key)
        return (entry["uri"], entry["web"]) if entry else ("", "")
    m = PLAIN_RE.match(device_uri or "")
    if m and not m.group(2).startswith("["):
        return device_uri, f"https://{m.group(2)}/"
    return "", ""


# ---------------------------------------------------------------- notify

NOTIFY = "--no-notify" not in sys.argv[1:]


def notify(title: str, body: str = "", urgent: bool = False) -> None:
    if not NOTIFY:
        return
    try:
        subprocess.Popen([NOTIFY_SEND, "-a", "Printer", "-i", "printer",
                          "-u", "critical" if urgent else "normal", title, body],
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
    except OSError:
        pass


# ---------------------------------------------------------------- network thread

class NetWatch(threading.Thread):
    """Avahi lookups, knocks and direct printer queries, off the main thread.

    The main thread hands over the current device URIs with set_printers()
    and reads results with snapshot(). Whenever a result changes what the
    panel shows, a byte is written to `wake_fd` so the main thread re-emits.
    """

    def __init__(self, files: dict, wake_fd: int):
        super().__init__(daemon=True)
        self.files = files
        self.wake_fd = wake_fd
        self.lock = threading.Lock()
        self.kick = threading.Event()
        self.printers: dict = {}         # name -> device-uri (set by main)
        self.network: dict = {}
        self.misses: dict = {}
        self.device: dict = {}           # name -> fresh readings
        self.resolved_at = 0.0
        self.device_at = 0.0
        self.want_device = True

    def set_printers(self, printers: dict) -> None:
        with self.lock:
            changed = printers != self.printers
            self.printers = dict(printers)
        if changed:
            self.kick.set()

    def request_device(self) -> None:
        with self.lock:
            self.want_device = True
        self.kick.set()

    def snapshot(self) -> tuple[dict, set, dict]:
        with self.lock:
            offline = {n for n, k in self.misses.items() if k >= OFFLINE_AFTER}
            return dict(self.network), offline, {k: dict(v) for k, v in self.device.items()}

    def wake(self) -> None:
        try:
            os.write(self.wake_fd, b"n")
        except OSError:
            pass

    def run(self) -> None:
        while True:
            try:
                self.cycle()
            except Exception:  # noqa: BLE001 - never let the thread die
                pass
            self.kick.wait(KNOCK_EVERY)
            self.kick.clear()

    def cycle(self) -> None:
        now = time.monotonic()
        with self.lock:
            printers = dict(self.printers)
            network = dict(self.network)
        net_printers = {n: u for n, u in printers.items() if is_network(u)}
        if not net_printers:
            return

        unresolved = any(device_key(u) and device_key(u) not in network for u in net_printers.values())
        if now - self.resolved_at > (RESOLVE_RETRY if unresolved else RESOLVE_EVERY) or not self.resolved_at:
            fresh = resolve_network()
            self.resolved_at = now
            # Merge, so a printer that is off right now keeps its last addresses.
            network = {**network, **fresh}
            with self.lock:
                self.network = network
            self.wake()  # web page links may have appeared

        changed = False
        back = False
        for name, uri in net_printers.items():
            targets = reach_targets(uri, network)
            ok = bool(targets) and knock(targets)
            with self.lock:
                before = self.misses.get(name, 0)
                self.misses[name] = 0 if ok else before + 1
                after = self.misses[name]
            if (before >= OFFLINE_AFTER) != (after >= OFFLINE_AFTER):
                changed = True
                back = back or ok
        if changed:
            self.wake()

        with self.lock:
            due = self.want_device or back or now - self.device_at > DEVICE_EVERY
            self.want_device = False
        if not due:
            return
        self.device_at = now
        retry = False
        for name, uri in net_printers.items():
            with self.lock:
                missed = self.misses.get(name, 0) > 0
            target, _ = direct_uri(uri, network)
            # Skip printers that just missed a knock: the query would only
            # sit out its timeout.
            if not target or missed:
                continue
            r = run_ipptool(target, self.files["device"])
            attrs = r[0][0] if r and r[0] else None
            if attrs and attrs.get("marker-names"):
                attrs["_at"] = str(int(time.time()))
                with self.lock:
                    self.device[name] = attrs
                self.wake()
            else:
                retry = True  # a sleeping printer can miss a query
        if retry:
            self.device_at = now - DEVICE_EVERY + 60


# ---------------------------------------------------------------- CUPS events

def die_with_parent() -> None:
    """Child setup: get SIGTERM if this script dies, however it dies."""
    try:
        ctypes.CDLL("libc.so.6", use_errno=True).prctl(1, signal.SIGTERM)  # PR_SET_PDEATHSIG
    except OSError:
        pass


class Events:
    """CUPS job/printer events over D-Bus, through a leased subscription.

    `fd` is readable whenever dbus-monitor saw a CUPS signal; `ok` is False if
    events could not be set up, in which case the main loop polls more often.
    """

    def __init__(self, files: dict):
        self.files = files
        self.proc = None
        self.sub_id = 0
        self.renew_at = 0.0
        self.fd = -1
        self.ok = False
        self.start()

    def start(self) -> None:
        self.stop()
        try:
            self.proc = subprocess.Popen(
                [DBUS_MONITOR, "--system", "type='signal',interface='org.cups.cupsd.Notifier'"],
                stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                preexec_fn=die_with_parent)
        except OSError:
            return
        self.fd = self.proc.stdout.fileno()
        fl = fcntl.fcntl(self.fd, fcntl.F_GETFL)
        fcntl.fcntl(self.fd, fcntl.F_SETFL, fl | os.O_NONBLOCK)
        r = run_ipptool("ipp://localhost/", self.files["subscribe"])
        sub = r[0][0] if r and r[0] else {}
        self.sub_id = to_int(sub.get("notify-subscription-id"), 0)
        self.renew_at = time.monotonic() + SUB_LEASE / 2
        self.ok = self.sub_id > 0

    def alive(self) -> bool:
        return bool(self.proc) and self.proc.poll() is None

    def drain(self) -> bool:
        """Read what dbus-monitor printed; True if it held a CUPS signal."""
        got = False
        try:
            for _ in range(64):  # bounded: at most 256 KiB per wake-up
                chunk = os.read(self.fd, 4096)
                if not chunk:
                    break
                if b"member=Job" in chunk or b"member=Printer" in chunk:
                    got = True
        except BlockingIOError:
            pass
        except OSError:
            pass
        return got

    def maintain(self) -> None:
        if not self.alive():
            self.start()
        elif self.ok and time.monotonic() > self.renew_at:
            self.renew_at = time.monotonic() + SUB_LEASE / 2
            # If CUPS lost the subscription (a restart), make a new one.
            if not ipptool_ok("ipp://localhost/", self.files["renew"], {"subid": self.sub_id}):
                self.sub_id = 0
                self.start()

    def stop(self) -> None:
        if self.sub_id > 0:
            ipptool_ok("ipp://localhost/", self.files["unsubscribe"], {"subid": self.sub_id})
            self.sub_id = 0
        if self.proc and self.proc.poll() is None:
            self.proc.terminate()
            try:
                self.proc.wait(timeout=2)
            except subprocess.TimeoutExpired:
                self.proc.kill()
        self.proc = None
        self.fd = -1
        self.ok = False


# ---------------------------------------------------------------- main loop

class Monitor:
    def __init__(self, tmpdir: str, net: NetWatch | None = None):
        self.files = {}
        for name, body in TESTS.items():
            path = os.path.join(tmpdir, name + ".test")
            with open(path, "w") as fh:
                fh.write(body)
            self.files[name] = path
        self.net = net
        self.cups: tuple = ([], [], [], "")  # last scheduler answer
        self.cups_ok = False
        self.active_jobs: dict = {}     # job id -> (name, printer)
        self.problems: set = set()      # (printer, keyword) already notified
        self.low: set = set()           # (printer, marker) already notified
        self.offline_told: set = set()  # printers already announced as offline
        self.first = True
        self.last = ""
        self.busy = False

    def poll_cups(self) -> None:
        res = run_ipptool("ipp://localhost/", self.files["cups"])
        if len(res) < 3:
            self.cups_ok = False
            return
        printers_raw = [p for p in res[0] if p.get("printer-name")][:MAX_PRINTERS]
        default = res[3][0].get("printer-name", "") if len(res) > 3 and res[3] else ""
        self.cups = (printers_raw, res[1], res[2], default)
        self.cups_ok = True
        if self.net:
            self.net.set_printers({p["printer-name"]: p.get("device-uri", "") for p in printers_raw})

    def build(self) -> dict:
        if not self.cups_ok:
            return {"ok": False, "error": "CUPS is not answering", "printers": [], "jobs": []}
        printers_raw, jobs_raw, done_raw, default = self.cups
        network, offline, device = self.net.snapshot() if self.net else ({}, set(), {})

        # CUPS adds a temporary queue for a network printer when an app prints
        # to it directly (a browser's print dialog, say). When a saved queue
        # already points at the same printer, fold the temporary one into it:
        # it would only show up as a second, identical printer.
        def same_device(p: dict) -> str:
            uri = p.get("device-uri", "")
            return device_key(uri) or uri
        saved = {same_device(p): p.get("printer-name", "") for p in printers_raw
                 if p.get("printer-is-temporary") != "true"}
        alias: dict = {}
        printers = []
        for p in printers_raw:
            name = p.get("printer-name", "")
            if not re.fullmatch(r"[A-Za-z0-9_.@-]{1,127}", name):
                continue
            if p.get("printer-is-temporary") == "true" and saved.get(same_device(p)):
                alias[name] = saved[same_device(p)]
                continue
            _, web = direct_uri(p.get("device-uri", ""), network)
            dev = device.get(name)
            reasons = reasons_from(p.get("printer-state-reasons", ""))
            if dev:
                for r in reasons_from(dev.get("printer-state-reasons", "")):
                    if r not in reasons:
                        reasons.append(r)
            markers = markers_from(dev if dev and dev.get("marker-names") else p)
            state = clip(p.get("printer-state", "unknown"), 16)
            accepting = p.get("printer-is-accepting-jobs", "true") == "true"
            alert = clip((dev or {}).get("printer-alert-description", "").split(",")[0], 40)
            printers.append({
                "name": name,
                "info": clip(p.get("printer-info", "") or name),
                "state": state,
                "accepting": accepting,
                "status": status_of(state, accepting, reasons, alert, name in offline),
                "problems": problems_of(reasons, markers),
                "message": clip(p.get("printer-state-message", "")),
                "reasons": reasons,
                "queued": max(0, to_int(p.get("queued-job-count", 0), 0)),
                "markers": markers,
                "media": media_label((dev or {}).get("media-ready", "")),
                "alert": alert,
                "readingsAt": to_int((dev or {}).get("_at", 0), 0),
                "web": web if re.fullmatch(r"https?://[A-Za-z0-9.-]+/", web or "") else "",
                "scanner": scanner_of(p.get("device-uri", ""), network),
            })

        user = os.environ.get("USER", "")
        jobs = []
        current: dict = {}
        for j in jobs_raw:
            jid = to_int(j.get("job-id"), 0)
            if jid <= 0:
                continue
            state = job_state(j.get("job-state")) or "pending"
            printer = j.get("job-printer-uri", "").rsplit("/", 1)[-1]
            printer = alias.get(printer, printer)
            jname = j.get("job-name", "")
            current[jid] = (jname, printer, state)
            if len(jobs) < MAX_JOBS:
                jobs.append({
                    "id": jid,
                    "printer": clip(printer, 127),
                    "name": clip(jname or "Untitled"),
                    "state": state,
                    "pages": max(0, to_int(j.get("job-impressions-completed", 0), 0)),
                    "mine": j.get("job-originating-user-name", "") == user,
                    "created": max(0, to_int(j.get("time-at-creation", 0), 0)),
                })

        finished = {to_int(j.get("job-id"), 0): j for j in done_raw if to_int(j.get("job-id"), 0) > 0}
        if self.first:
            self.seed(printers)
        else:
            self.notify_changes(printers, current, finished)
        # A job just left the queue: read fresh toner soon.
        if self.net and any(jid not in current for jid in self.active_jobs):
            self.net.request_device()
        self.active_jobs = current
        self.first = False
        # Poll fast only while something is actually printing; a job waiting
        # for an offline printer does not need a 2-second loop.
        self.busy = (any(s == "printing" for _, _, s in current.values())
                     or any(p["state"] == "processing" for p in printers))
        return {"ok": True, "default": clip(default, 127), "printers": printers, "jobs": jobs}

    def poll(self) -> dict:
        self.poll_cups()
        return self.build()

    def seed(self, printers: list) -> None:
        """Remember conditions present at start, so they are not announced."""
        for p in printers:
            for r in p["reasons"]:
                for key in PROBLEMS:
                    if r.startswith(key):
                        self.problems.add((p["name"], key))
            for m in p["markers"]:
                if 0 <= m["level"] <= m["low"]:
                    self.low.add((p["name"], m["name"]))

    def notify_changes(self, printers: list, current: dict, finished: dict) -> None:
        for jid, (jname, _printer, _state) in self.active_jobs.items():
            if jid in current:
                continue
            state = job_state((finished.get(jid) or {}).get("job-state"))
            label = clip(jname or "Document")
            if state == "completed":
                notify("Printed", label)
            elif state == "aborted":
                notify("Printing failed", label, urgent=True)
        for p in printers:
            # Offline with work waiting: say so once per outage.
            if p["status"] == "Offline" and p["queued"] > 0:
                if p["name"] not in self.offline_told:
                    self.offline_told.add(p["name"])
                    n = p["queued"]
                    notify("Printer offline", f"{p['info']}: {n} job{'s' if n != 1 else ''} waiting", urgent=True)
            elif p["status"] != "Offline":
                self.offline_told.discard(p["name"])
            keys = set()
            for r in p["reasons"]:
                for key, text in PROBLEMS.items():
                    if r.startswith(key):
                        keys.add(key)
                        if (p["name"], key) not in self.problems:
                            notify(text, p["info"], urgent=True)
            self.problems = {k for k in self.problems if k[0] != p["name"]} | {(p["name"], k) for k in keys}
            lows = set()
            for m in p["markers"]:
                if 0 <= m["level"] <= m["low"]:
                    lows.add(m["name"])
                    if (p["name"], m["name"]) not in self.low:
                        notify(f"{m['name']} toner low", f"{p['info']}: {m['level']}% left")
            self.low = {k for k in self.low if k[0] != p["name"]} | {(p["name"], n) for n in lows}

    def emit(self, payload: dict) -> None:
        line = json.dumps(payload, separators=(",", ":"))
        if len(line) > MAX_RECORD:
            payload = dict(payload, jobs=[], printers=[dict(p, markers=[], reasons=p["reasons"][:2])
                                                        for p in payload.get("printers", [])])
            line = json.dumps(payload, separators=(",", ":"))
            if len(line) > MAX_RECORD:
                line = json.dumps({"ok": False, "error": "status too large", "printers": [], "jobs": []})
        if line != self.last:
            self.last = line
            print(line, flush=True)


def main() -> int:
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    signal.signal(signal.SIGHUP, lambda *_: sys.exit(0))
    signal.signal(signal.SIGPIPE, signal.SIG_DFL)
    tmpdir = tempfile.mkdtemp(prefix="omarchy-printer-")
    events = None
    try:
        wake_r, wake_w = os.pipe()
        os.set_blocking(wake_r, False)
        mon = Monitor(tmpdir)
        net = NetWatch(mon.files, wake_w)
        mon.net = net
        mon.poll_cups()
        net.start()
        events = Events(mon.files)
        next_poll = 0.0
        while True:
            now = time.monotonic()
            if now >= next_poll:
                mon.poll_cups()
                interval = POLL_ACTIVE if mon.busy else (POLL_IDLE if events.ok else POLL_IDLE_NO_EVENTS)
                next_poll = now + interval
            mon.emit(mon.build())
            # build() may have changed `busy`; tighten the schedule if so.
            if mon.busy:
                next_poll = min(next_poll, time.monotonic() + POLL_ACTIVE)

            watch = [wake_r, sys.stdin] + ([events.fd] if events.fd >= 0 else [])
            try:
                ready, _, _ = select.select(watch, [], [], max(0.05, next_poll - time.monotonic()))
            except (OSError, ValueError):
                ready = []
                time.sleep(1)
            if wake_r in ready:
                try:
                    os.read(wake_r, 4096)
                except OSError:
                    pass
            if sys.stdin in ready:
                line = sys.stdin.readline(64)
                if not line:
                    return 0  # the panel went away
                elif line.strip() == "refresh":
                    next_poll = 0.0
                    net.request_device()
            if events.fd >= 0 and events.fd in ready and events.drain():
                # Let a burst of signals settle, then poll once.
                time.sleep(EVENT_DEBOUNCE)
                events.drain()
                next_poll = 0.0
            events.maintain()
    finally:
        if events:
            events.stop()
        shutil.rmtree(tmpdir, ignore_errors=True)


if __name__ == "__main__":
    sys.exit(main())
